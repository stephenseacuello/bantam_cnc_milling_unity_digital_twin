# =============================================================================
# MIRACLE Dashboard Docker Build
# =============================================================================
# Builds the MIRACLE web dashboard (React / Node.js) and serves it via nginx.
#
# Build:
#   docker build -f docker/Dockerfile.dashboard -t miracle_dashboard:latest ..
#
# Run:
#   docker run --rm -it -p 3000:80 miracle_dashboard:latest
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Build -- compile the dashboard front-end
# ---------------------------------------------------------------------------
FROM node:20-slim AS builder

WORKDIR /app

# Copy package manifests first for better layer caching
COPY src/miracle_dashboard/package*.json ./

# Install dependencies
RUN npm install --production=false

# Copy the rest of the dashboard source
COPY src/miracle_dashboard/ ./

# Build the production bundle
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: Serve -- lightweight nginx to serve the static build
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

# Remove default nginx site
RUN rm -rf /usr/share/nginx/html/*

# Copy build output from the builder stage (react-scripts outputs to build/)
COPY --from=builder /app/build/ /usr/share/nginx/html/

# Custom nginx configuration for SPA routing
RUN cat > /etc/nginx/conf.d/default.conf <<'NGINXCONF'
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback: serve index.html for any route not matching a static file
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets aggressively
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Health endpoint
    location /health {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }
}
NGINXCONF

EXPOSE 80

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
