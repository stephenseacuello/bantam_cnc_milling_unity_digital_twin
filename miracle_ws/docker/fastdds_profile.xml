<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>udp_transport</transport_id>
                <type>UDPv4</type>
            </transport_descriptor>
        </transport_descriptors>

        <participant profile_name="miracle_participant" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>udp_transport</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
                <builtin>
                    <discovery_config>
                        <leaseDuration>
                            <sec>20</sec>
                        </leaseDuration>
                    </discovery_config>
                </builtin>

                <!-- DDS Security Plugins (enabled when MIRACLE_SROS2_ENABLED=true) -->
                <!-- Authentication: PKI-DH mutual authentication -->
                <propertiesPolicy>
                    <properties>
                        <property>
                            <name>dds.sec.auth.plugin</name>
                            <value>builtin.PKI-DH</value>
                        </property>
                        <property>
                            <name>dds.sec.auth.builtin.PKI-DH.identity_ca</name>
                            <value>file://${MIRACLE_SECURITY_KEYSTORE}/public/ca.cert.pem</value>
                        </property>
                        <property>
                            <name>dds.sec.auth.builtin.PKI-DH.identity_certificate</name>
                            <value>file://${MIRACLE_SECURITY_KEYSTORE}/enclaves/${MIRACLE_NODE_ENCLAVE}/cert.pem</value>
                        </property>
                        <property>
                            <name>dds.sec.auth.builtin.PKI-DH.private_key</name>
                            <value>file://${MIRACLE_SECURITY_KEYSTORE}/enclaves/${MIRACLE_NODE_ENCLAVE}/key.pem</value>
                        </property>

                        <!-- Access Control: Governance + Permissions -->
                        <property>
                            <name>dds.sec.access.plugin</name>
                            <value>builtin.Access-Permissions</value>
                        </property>
                        <property>
                            <name>dds.sec.access.builtin.Access-Permissions.permissions_ca</name>
                            <value>file://${MIRACLE_SECURITY_KEYSTORE}/public/ca.cert.pem</value>
                        </property>
                        <property>
                            <name>dds.sec.access.builtin.Access-Permissions.governance</name>
                            <value>file://${MIRACLE_SECURITY_KEYSTORE}/enclaves/${MIRACLE_NODE_ENCLAVE}/governance.p7s</value>
                        </property>
                        <property>
                            <name>dds.sec.access.builtin.Access-Permissions.permissions</name>
                            <value>file://${MIRACLE_SECURITY_KEYSTORE}/enclaves/${MIRACLE_NODE_ENCLAVE}/permissions.p7s</value>
                        </property>

                        <!-- Cryptographic: AES-GCM-GMAC -->
                        <property>
                            <name>dds.sec.crypto.plugin</name>
                            <value>builtin.AES-GCM-GMAC</value>
                        </property>
                    </properties>
                </propertiesPolicy>
            </rtps>
        </participant>
    </profiles>
</dds>
