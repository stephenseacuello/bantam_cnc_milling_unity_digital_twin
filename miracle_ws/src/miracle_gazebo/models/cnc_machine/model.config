<?xml version="1.0" ?>
<model>
  <name>cnc_machine</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>MIRACLE Team</name>
    <email>miracle@example.com</email>
  </author>

  <description>
    CNC milling machine model for the MIRACLE digital twin simulation.
    Features a base frame (1.5 x 1.0 x 1.2 m), X/Y/Z prismatic axis
    joints, and a revolute spindle assembly.  Industrial grey finish
    with proper inertia and collision geometry.
  </description>
</model>
