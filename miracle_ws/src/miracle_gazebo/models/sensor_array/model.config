<?xml version="1.0" ?>
<model>
  <name>sensor_array</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>MIRACLE Team</name>
    <email>miracle@example.com</email>
  </author>

  <description>
    Multi-sensor array for CNC machine monitoring in the MIRACLE digital
    twin.  Includes a camera sensor (640x480 @ 30 Hz), an IMU sensor
    (200 Hz), and a microphone placeholder (box geometry) for acoustic
    monitoring.  Designed to be mounted near CNC machines.
  </description>
</model>
