<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="cnc_factory">

    <!-- ============================================================ -->
    <!-- Physics                                                       -->
    <!-- ============================================================ -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ============================================================ -->
    <!-- Plugins                                                       -->
    <!-- ============================================================ -->
    <!-- Core Gazebo system plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact">
    </plugin>

    <!-- ============================================================ -->
    <!-- Lighting                                                      -->
    <!-- ============================================================ -->
    <!-- Ambient scene lighting -->
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.75 0.8 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Main overhead directional light (factory ceiling) -->
    <light type="directional" name="factory_overhead_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
      <direction>-0.2 0.1 -1.0</direction>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Secondary fill light -->
    <light type="directional" name="factory_fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.4 0.4 0.45 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
      <direction>0.3 -0.2 -0.8</direction>
    </light>

    <!-- ============================================================ -->
    <!-- Ground Plane – Industrial Floor                               -->
    <!-- ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.42 1.0</ambient>
            <diffuse>0.5 0.5 0.47 1.0</diffuse>
            <specular>0.15 0.15 0.15 1.0</specular>
            <!-- Industrial concrete floor appearance -->
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- CNC Machine 1                                                 -->
    <!-- ============================================================ -->
    <include>
      <uri>model://cnc_machine</uri>
      <name>cnc_machine_1</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ============================================================ -->
    <!-- CNC Machine 2                                                 -->
    <!-- ============================================================ -->
    <include>
      <uri>model://cnc_machine</uri>
      <name>cnc_machine_2</name>
      <pose>3 0 0 0 0 0</pose>
    </include>

    <!-- ============================================================ -->
    <!-- CNC Machine 3                                                 -->
    <!-- ============================================================ -->
    <include>
      <uri>model://cnc_machine</uri>
      <name>cnc_machine_3</name>
      <pose>6 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
