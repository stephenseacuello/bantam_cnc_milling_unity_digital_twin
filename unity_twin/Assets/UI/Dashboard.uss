/* Full-width overlay with transparent center pass-through */
.dashboard {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
    width: 100%;
    height: 100%;
    picking-mode: ignore;
}

.header-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 8px;
    background-color: rgba(20, 20, 30, 0.92);
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 140, 220, 0.4);
    min-height: 32px;
    picking-mode: position;
}

.title {
    font-size: 14px;
    color: rgb(200, 210, 230);
    -unity-font-style: bold;
}

.connection-badge {
    font-size: 11px;
    color: rgb(255, 80, 80);
    padding: 2px 8px;
    background-color: rgba(255, 0, 0, 0.15);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 80, 80, 0.3);
}

.main-row {
    flex-grow: 1;
    flex-direction: row;
    overflow: hidden;
    picking-mode: ignore;
}

.sidebar {
    width: 260px;
    min-width: 260px;
    max-width: 260px;
    padding: 4px;
    background-color: rgba(15, 15, 25, 0.88);
    overflow: scroll;
    flex-grow: 0;
    flex-shrink: 0;
    picking-mode: position;
}

.gcode-sidebar {
    width: 280px;
    min-width: 280px;
    max-width: 280px;
}

.viewport {
    flex-grow: 1;
    picking-mode: ignore;
}

.gcode-toolbar {
    flex-direction: row;
    margin-bottom: 4px;
    picking-mode: position;
}

.gcode-status-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

.gcode-text-field {
    flex-grow: 1;
    min-height: 200px;
    font-size: 10px;
    color: rgb(200, 220, 200);
    background-color: rgba(10, 10, 20, 0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.5);
    white-space: normal;
    picking-mode: position;
}

.gcode-progress-bar {
    height: 14px;
    margin-bottom: 3px;
}

.gcode-info-row {
    flex-direction: row;
    margin-bottom: 2px;
}

.shortcut-hint {
    font-size: 9px;
    color: rgb(120, 130, 150);
    -unity-font-style: italic;
}

.panel {
    margin-bottom: 4px;
    padding: 4px 6px;
    background-color: rgba(30, 30, 45, 0.75);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.5);
}

.panel-title {
    font-size: 12px;
    color: rgb(100, 170, 255);
    -unity-font-style: bold;
    margin-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 140, 220, 0.3);
    padding-bottom: 2px;
}

.data-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 1px;
    padding: 0;
}

.data-label {
    font-size: 11px;
    color: rgb(150, 160, 180);
}

.data-value {
    font-size: 11px;
    color: rgb(220, 230, 245);
    -unity-font-style: bold;
}

.force-x { color: rgb(255, 100, 100); }
.force-y { color: rgb(100, 255, 100); }
.force-z { color: rgb(100, 150, 255); }

.wear-progress {
    height: 12px;
    margin-bottom: 3px;
}

.oee-value {
    font-size: 12px;
    color: rgb(100, 220, 150);
}

.control-bar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 3px 6px;
    background-color: rgba(20, 20, 30, 0.92);
    border-top-width: 1px;
    border-top-color: rgba(80, 140, 220, 0.4);
    min-height: 28px;
    picking-mode: position;
}

.control-btn {
    padding: 2px 6px;
    margin: 1px 2px;
    background-color: rgba(50, 50, 70, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(80, 80, 100, 0.5);
    color: rgb(200, 210, 230);
    font-size: 10px;
}

.control-btn:hover {
    background-color: rgba(70, 70, 95, 0.9);
}

.play {
    background-color: rgba(40, 100, 60, 0.8);
    border-color: rgba(60, 140, 80, 0.6);
}

.speed-slider {
    width: 80px;
    margin: 0 4px;
}

.speed-text {
    font-size: 10px;
    color: rgb(180, 190, 210);
    width: 30px;
}

.mode-dropdown {
    font-size: 10px;
}

.sim-time {
    font-size: 12px;
    color: rgb(100, 200, 255);
    -unity-font-style: bold;
    margin: 2px 4px;
}

.spacer {
    flex-grow: 1;
}

.robot-status {
    font-size: 10px;
    color: rgb(170, 180, 200);
    margin-right: 4px;
}

.estop-btn {
    padding: 3px 10px;
    background-color: rgba(180, 20, 20, 0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(220, 50, 50);
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
}

.estop-btn:hover {
    background-color: rgba(220, 30, 30, 1);
}

.status-idle { color: rgb(150, 150, 170); }

.machine-dropdown {
    min-width: 100px;
    font-size: 11px;
    color: rgb(200, 210, 230);
    background-color: rgba(40, 40, 60, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(80, 80, 100, 0.5);
}

.chart-container {
    height: 120px;
    min-height: 120px;
    background-color: rgba(10, 10, 15, 0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.5);
    margin-top: 2px;
}

.chart-title {
    font-size: 10px;
    margin-bottom: 1px;
    padding-bottom: 1px;
}

.record {
    color: rgb(255, 80, 80);
}

.recording {
    background-color: rgba(200, 30, 30, 0.6);
    color: rgb(255, 255, 255);
}

.replay-slider {
    width: 120px;
    min-width: 100px;
    margin-left: 4px;
    margin-right: 4px;
}

.replay-time {
    font-size: 10px;
    color: rgb(160, 170, 190);
    min-width: 60px;
}

/* Fleet Overview Panel */
.fleet-panel {
    position: absolute;
    top: 40px;
    left: 270px;
    right: 290px;
    bottom: 40px;
    background-color: rgba(15, 15, 25, 0.95);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 140, 220, 0.4);
    padding: 8px;
    overflow: scroll;
}

.fleet-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 140, 220, 0.3);
    padding-bottom: 4px;
}

.fleet-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.fleet-card {
    width: 220px;
    min-height: 180px;
    margin: 4px;
    padding: 8px;
    background-color: rgba(30, 30, 50, 0.85);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.5);
}

.fleet-card:hover {
    border-color: rgba(100, 170, 255, 0.6);
    background-color: rgba(35, 35, 55, 0.9);
}

.fleet-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.fleet-status-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(128, 128, 140);
    margin-right: 6px;
}

.fleet-card-id {
    font-size: 13px;
    color: rgb(200, 210, 230);
    -unity-font-style: bold;
    flex-grow: 1;
}

.fleet-alert-badge {
    font-size: 10px;
    color: rgb(255, 255, 255);
    background-color: rgba(220, 50, 50, 0.9);
    border-radius: 8px;
    padding: 1px 5px;
    min-width: 16px;
    -unity-text-align: middle-center;
}

.fleet-status-label {
    font-size: 11px;
    color: rgb(150, 160, 180);
    margin-bottom: 4px;
}

.fleet-sparkline {
    height: 40px;
    background-color: rgba(10, 10, 20, 0.8);
    border-radius: 3px;
    margin-bottom: 4px;
}

.fleet-data-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    font-size: 10px;
    color: rgb(150, 160, 180);
}

.fleet-wear-bar {
    flex-grow: 1;
    height: 8px;
    margin-left: 4px;
}

.fleet-progress-bar {
    flex-grow: 1;
    height: 8px;
    margin-left: 4px;
}

.fleet-metrics-row {
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    padding: 8px;
    margin-top: 8px;
    background-color: rgba(30, 30, 50, 0.6);
    border-radius: 4px;
}

.fleet-metric-label {
    font-size: 12px;
    color: rgb(100, 200, 255);
    -unity-font-style: bold;
}

/* Decision Support Panel */
.decision-panel {
    position: absolute;
    top: 40px;
    right: 0;
    width: 320px;
    bottom: 40px;
    background-color: rgba(15, 15, 25, 0.95);
    border-radius: 8px 0 0 8px;
    border-width: 1px;
    border-color: rgba(80, 140, 220, 0.4);
    padding: 8px;
    overflow: scroll;
    translate: 320px 0;
    transition-property: translate;
    transition-duration: 300ms;
}

.decision-panel.visible {
    translate: 0 0;
}

.decision-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 140, 220, 0.3);
    padding-bottom: 4px;
}

.decision-situation {
    font-size: 12px;
    color: rgb(220, 200, 100);
    margin-bottom: 8px;
    white-space: normal;
}

.decision-section {
    margin-bottom: 8px;
    padding: 6px;
    background-color: rgba(30, 30, 50, 0.6);
    border-radius: 4px;
}

.decision-section-title {
    font-size: 11px;
    color: rgb(100, 170, 255);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.decision-root-cause {
    font-size: 11px;
    color: rgb(255, 180, 100);
    white-space: normal;
}

.decision-actions-list {
    flex-direction: column;
}

.decision-action-item {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin-bottom: 3px;
    background-color: rgba(40, 60, 80, 0.5);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(60, 100, 140, 0.3);
}

.decision-action-item:hover {
    background-color: rgba(50, 70, 100, 0.7);
    border-color: rgba(100, 170, 255, 0.5);
}

.decision-action-text {
    font-size: 11px;
    color: rgb(200, 210, 230);
    flex-grow: 1;
    white-space: normal;
}

.decision-action-rank {
    font-size: 10px;
    color: rgb(100, 200, 150);
    margin-right: 6px;
    -unity-font-style: bold;
}

.whatif-slider {
    margin-top: 4px;
    margin-bottom: 4px;
}

.whatif-result {
    font-size: 11px;
    color: rgb(180, 200, 220);
    white-space: normal;
}
