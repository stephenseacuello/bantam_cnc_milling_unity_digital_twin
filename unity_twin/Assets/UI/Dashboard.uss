/* Full-width overlay with transparent center pass-through */
.dashboard {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
    width: 100%;
    height: 100%;
    picking-mode: ignore;
}

.header-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 8px;
    background-color: rgba(20, 20, 30, 0.92);
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 140, 220, 0.4);
    min-height: 32px;
    picking-mode: position;
}

.title {
    font-size: 14px;
    color: rgb(200, 210, 230);
    -unity-font-style: bold;
}

.connection-badge {
    font-size: 11px;
    color: rgb(255, 80, 80);
    padding: 2px 8px;
    background-color: rgba(255, 0, 0, 0.15);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 80, 80, 0.3);
}

.main-row {
    flex-grow: 1;
    flex-direction: row;
    overflow: hidden;
    picking-mode: ignore;
}

.sidebar {
    width: 260px;
    min-width: 260px;
    max-width: 260px;
    padding: 4px;
    background-color: rgba(15, 15, 25, 0.88);
    overflow: scroll;
    flex-grow: 0;
    flex-shrink: 0;
    picking-mode: position;
}

.gcode-sidebar {
    width: 280px;
    min-width: 280px;
    max-width: 280px;
}

.viewport {
    flex-grow: 1;
    picking-mode: ignore;
}

.gcode-toolbar {
    flex-direction: row;
    margin-bottom: 4px;
    picking-mode: position;
}

.gcode-status-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

.gcode-text-field {
    flex-grow: 1;
    min-height: 200px;
    font-size: 10px;
    color: rgb(200, 220, 200);
    background-color: rgba(10, 10, 20, 0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.5);
    white-space: normal;
    picking-mode: position;
}

.gcode-progress-bar {
    height: 14px;
    margin-bottom: 3px;
}

.gcode-info-row {
    flex-direction: row;
    margin-bottom: 2px;
}

.shortcut-hint {
    font-size: 9px;
    color: rgb(120, 130, 150);
    -unity-font-style: italic;
}

.panel {
    margin-bottom: 4px;
    padding: 4px 6px;
    background-color: rgba(30, 30, 45, 0.75);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.5);
}

.panel-title {
    font-size: 12px;
    color: rgb(100, 170, 255);
    -unity-font-style: bold;
    margin-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 140, 220, 0.3);
    padding-bottom: 2px;
}

.data-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 1px;
    padding: 0;
}

.data-label {
    font-size: 11px;
    color: rgb(150, 160, 180);
}

.data-value {
    font-size: 11px;
    color: rgb(220, 230, 245);
    -unity-font-style: bold;
}

.force-x { color: rgb(255, 100, 100); }
.force-y { color: rgb(100, 255, 100); }
.force-z { color: rgb(100, 150, 255); }

.wear-progress {
    height: 12px;
    margin-bottom: 3px;
}

.oee-value {
    font-size: 12px;
    color: rgb(100, 220, 150);
}

.control-bar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 3px 6px;
    background-color: rgba(20, 20, 30, 0.92);
    border-top-width: 1px;
    border-top-color: rgba(80, 140, 220, 0.4);
    min-height: 28px;
    picking-mode: position;
}

.control-btn {
    padding: 2px 6px;
    margin: 1px 2px;
    background-color: rgba(50, 50, 70, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(80, 80, 100, 0.5);
    color: rgb(200, 210, 230);
    font-size: 10px;
}

.control-btn:hover {
    background-color: rgba(70, 70, 95, 0.9);
}

.play {
    background-color: rgba(40, 100, 60, 0.8);
    border-color: rgba(60, 140, 80, 0.6);
}

.speed-slider {
    width: 80px;
    margin: 0 4px;
}

.speed-text {
    font-size: 10px;
    color: rgb(180, 190, 210);
    width: 30px;
}

.mode-dropdown {
    font-size: 10px;
}

.sim-time {
    font-size: 12px;
    color: rgb(100, 200, 255);
    -unity-font-style: bold;
    margin: 2px 4px;
}

.spacer {
    flex-grow: 1;
}

.robot-status {
    font-size: 10px;
    color: rgb(170, 180, 200);
    margin-right: 4px;
}

.estop-btn {
    padding: 3px 10px;
    background-color: rgba(180, 20, 20, 0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(220, 50, 50);
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
}

.estop-btn:hover {
    background-color: rgba(220, 30, 30, 1);
}

.status-idle { color: rgb(150, 150, 170); }

.machine-dropdown {
    min-width: 100px;
    font-size: 11px;
    color: rgb(200, 210, 230);
    background-color: rgba(40, 40, 60, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(80, 80, 100, 0.5);
}

.chart-container {
    height: 120px;
    min-height: 120px;
    background-color: rgba(10, 10, 15, 0.9);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.5);
    margin-top: 2px;
}

.chart-title {
    font-size: 10px;
    margin-bottom: 1px;
    padding-bottom: 1px;
}

.record {
    color: rgb(255, 80, 80);
}

.recording {
    background-color: rgba(200, 30, 30, 0.6);
    color: rgb(255, 255, 255);
}

.replay-slider {
    width: 120px;
    min-width: 100px;
    margin-left: 4px;
    margin-right: 4px;
}

.replay-time {
    font-size: 10px;
    color: rgb(160, 170, 190);
    min-width: 60px;
}

/* Fleet Overview Panel */
.fleet-panel {
    position: absolute;
    top: 40px;
    left: 270px;
    right: 290px;
    bottom: 40px;
    background-color: rgba(15, 15, 25, 0.95);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 140, 220, 0.4);
    padding: 8px;
    overflow: scroll;
}

.fleet-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 140, 220, 0.3);
    padding-bottom: 4px;
}

.fleet-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.fleet-card {
    width: 220px;
    min-height: 180px;
    margin: 4px;
    padding: 8px;
    background-color: rgba(30, 30, 50, 0.85);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.5);
}

.fleet-card:hover {
    border-color: rgba(100, 170, 255, 0.6);
    background-color: rgba(35, 35, 55, 0.9);
}

.fleet-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.fleet-status-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgb(128, 128, 140);
    margin-right: 6px;
}

.fleet-card-id {
    font-size: 13px;
    color: rgb(200, 210, 230);
    -unity-font-style: bold;
    flex-grow: 1;
}

.fleet-alert-badge {
    font-size: 10px;
    color: rgb(255, 255, 255);
    background-color: rgba(220, 50, 50, 0.9);
    border-radius: 8px;
    padding: 1px 5px;
    min-width: 16px;
    -unity-text-align: middle-center;
}

.fleet-status-label {
    font-size: 11px;
    color: rgb(150, 160, 180);
    margin-bottom: 4px;
}

.fleet-sparkline {
    height: 40px;
    background-color: rgba(10, 10, 20, 0.8);
    border-radius: 3px;
    margin-bottom: 4px;
}

.fleet-data-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    font-size: 10px;
    color: rgb(150, 160, 180);
}

.fleet-wear-bar {
    flex-grow: 1;
    height: 8px;
    margin-left: 4px;
}

.fleet-progress-bar {
    flex-grow: 1;
    height: 8px;
    margin-left: 4px;
}

.fleet-sparkline-mode-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 4px;
}

.fleet-sparkline-mode-btn {
    font-size: 9px;
    padding: 1px 4px;
    margin: 0 1px;
    min-width: 18px;
    background-color: rgba(40, 40, 60, 0.6);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(60, 60, 80, 0.4);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.fleet-sparkline-mode-btn:hover {
    background-color: rgba(60, 60, 90, 0.8);
}

.fleet-sparkline-mode-btn-active {
    background-color: rgba(80, 140, 220, 0.35);
    border-color: rgba(100, 170, 255, 0.6);
}

.fleet-metrics-row {
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    padding: 8px;
    margin-top: 8px;
    background-color: rgba(30, 30, 50, 0.6);
    border-radius: 4px;
}

.fleet-metric-label {
    font-size: 12px;
    color: rgb(100, 200, 255);
    -unity-font-style: bold;
}

/* ── Fleet Health Summary ──────────────────────────────────────── */

.fleet-health-summary {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 10px;
    margin-bottom: 8px;
    background-color: rgba(25, 30, 50, 0.85);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 140, 220, 0.3);
}

.fleet-health-score-label {
    font-size: 14px;
    color: rgb(100, 220, 150);
    -unity-font-style: bold;
}

.fleet-health-summary-metrics {
    flex-direction: row;
}

.fleet-health-metric {
    font-size: 11px;
    color: rgb(180, 190, 210);
    margin-left: 16px;
}

.fleet-health-summary-row {
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    padding: 6px 8px;
    margin-top: 4px;
    background-color: rgba(25, 30, 50, 0.7);
    border-radius: 4px;
}

/* ── Predictive Health Ring ────────────────────────────────────── */

.fleet-health-ring {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
    margin-top: 3px;
}

.health-ring-track {
    flex-grow: 1;
    height: 6px;
    background-color: rgba(40, 40, 60, 0.8);
    border-radius: 3px;
    overflow: hidden;
}

.health-ring-fill {
    height: 100%;
    border-radius: 3px;
    transition-property: width, background-color;
    transition-duration: 400ms;
}

.health-ring-label {
    font-size: 10px;
    color: rgb(200, 210, 230);
    -unity-font-style: bold;
    min-width: 32px;
    -unity-text-align: middle-right;
    margin-left: 4px;
}

/* ── RUL Countdown Bar ────────────────────────────────────────── */

.fleet-rul-container {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.rul-bar-track {
    flex-grow: 1;
    height: 6px;
    background-color: rgba(40, 40, 60, 0.8);
    border-radius: 3px;
    overflow: hidden;
}

.rul-bar-fill {
    height: 100%;
    border-radius: 3px;
    transition-property: width, background-color;
    transition-duration: 400ms;
}

.rul-bar-label {
    font-size: 9px;
    color: rgb(180, 190, 210);
    min-width: 48px;
    -unity-text-align: middle-right;
    margin-left: 4px;
}

/* ── Anomaly Countdown Badge ──────────────────────────────────── */

.fleet-anomaly-badge {
    flex-direction: row;
    align-items: center;
    padding: 2px 6px;
    margin-bottom: 3px;
    background-color: rgba(220, 160, 20, 0.2);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(220, 160, 20, 0.4);
}

.anomaly-badge-label {
    font-size: 10px;
    color: rgb(255, 210, 80);
    -unity-font-style: bold;
}

.anomaly-badge-critical {
    background-color: rgba(220, 50, 50, 0.25);
    border-color: rgba(255, 80, 80, 0.6);
}

.anomaly-badge-critical .anomaly-badge-label {
    color: rgb(255, 100, 100);
}

/* ── OEE Trend Arrow ──────────────────────────────────────────── */

.fleet-trend-arrow {
    font-size: 10px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.trend-improving {
    color: rgb(80, 220, 120);
}

.trend-stable {
    color: rgb(180, 190, 210);
}

.trend-degrading {
    color: rgb(255, 100, 100);
}

/* Decision Support Panel */
.decision-panel {
    position: absolute;
    top: 40px;
    right: 0;
    width: 320px;
    bottom: 40px;
    background-color: rgba(15, 15, 25, 0.95);
    border-radius: 8px 0 0 8px;
    border-width: 1px;
    border-color: rgba(80, 140, 220, 0.4);
    padding: 8px;
    overflow: scroll;
    translate: 320px 0;
    transition-property: translate;
    transition-duration: 300ms;
}

.decision-panel.visible {
    translate: 0 0;
}

.decision-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 140, 220, 0.3);
    padding-bottom: 4px;
}

.decision-situation {
    font-size: 12px;
    color: rgb(220, 200, 100);
    margin-bottom: 8px;
    white-space: normal;
}

.decision-section {
    margin-bottom: 8px;
    padding: 6px;
    background-color: rgba(30, 30, 50, 0.6);
    border-radius: 4px;
}

.decision-section-title {
    font-size: 11px;
    color: rgb(100, 170, 255);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.decision-root-cause {
    font-size: 11px;
    color: rgb(255, 180, 100);
    white-space: normal;
}

.decision-actions-list {
    flex-direction: column;
}

.decision-action-item {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin-bottom: 3px;
    background-color: rgba(40, 60, 80, 0.5);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(60, 100, 140, 0.3);
}

.decision-action-item:hover {
    background-color: rgba(50, 70, 100, 0.7);
    border-color: rgba(100, 170, 255, 0.5);
}

.decision-action-text {
    font-size: 11px;
    color: rgb(200, 210, 230);
    flex-grow: 1;
    white-space: normal;
}

.decision-action-rank {
    font-size: 10px;
    color: rgb(100, 200, 150);
    margin-right: 6px;
    -unity-font-style: bold;
}

.whatif-slider {
    margin-top: 4px;
    margin-bottom: 4px;
}

.whatif-result {
    font-size: 11px;
    color: rgb(180, 200, 220);
    white-space: normal;
}

/* Alert Timeline Panel */
.alert-timeline-panel {
    position: absolute;
    left: 260px;
    bottom: 0;
    width: 350px;
    height: 300px;
    background-color: rgba(20, 22, 28, 0.95);
    border-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-radius: 8px;
    padding: 8px;
}

.alert-timeline-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.alert-timeline-title {
    font-size: 14px;
    color: rgb(200, 210, 225);
    -unity-font-style: bold;
}

.alert-timeline-count {
    font-size: 11px;
    color: rgba(200, 210, 225, 0.6);
}

.alert-timeline-filters {
    flex-direction: row;
    padding: 4px 0;
}

.alert-filter-btn {
    font-size: 10px;
    padding: 2px 8px;
    margin-right: 4px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    color: rgba(200, 210, 225, 0.7);
    border-width: 0;
}

.alert-filter-active {
    background-color: rgba(59, 130, 246, 0.3);
    color: rgb(147, 197, 253);
}

.alert-timeline-scroll {
    flex-grow: 1;
}

.alert-card {
    flex-direction: row;
    margin-bottom: 4px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.03);
    overflow: hidden;
}

.alert-severity-bar {
    width: 3px;
    min-height: 40px;
}

.alert-card-content {
    flex-grow: 1;
    padding: 4px 8px;
}

.alert-card-header {
    flex-direction: row;
    justify-content: space-between;
}

.alert-type-label {
    font-size: 11px;
    color: rgb(200, 210, 225);
    -unity-font-style: bold;
}

.alert-time-label {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.5);
}

.alert-card-detail {
    flex-direction: row;
    padding-top: 2px;
}

.alert-machine-label {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.6);
    background-color: rgba(255, 255, 255, 0.05);
    padding: 1px 6px;
    border-radius: 3px;
    margin-right: 8px;
}

.alert-severity-label {
    font-size: 10px;
    -unity-font-style: bold;
}

.alert-category-badge {
    font-size: 9px;
    padding: 1px 6px;
    border-radius: 8px;
    margin-top: 2px;
    align-self: flex-start;
}

.alert-badge-anomaly {
    background-color: rgba(234, 179, 8, 0.2);
    color: rgb(250, 204, 21);
}

.alert-badge-correlated {
    background-color: rgba(168, 85, 247, 0.2);
    color: rgb(196, 148, 249);
}

.alert-badge-security {
    background-color: rgba(239, 68, 68, 0.2);
    color: rgb(248, 113, 113);
}

/* ── Notification Toast System ──────────────────────────────────── */

.toast-container {
    position: absolute;
    top: 60px;
    right: 10px;
    width: 320px;
    flex-direction: column;
    picking-mode: ignore;
}

.toast {
    flex-direction: row;
    margin-bottom: 8px;
    border-radius: 6px;
    background-color: rgba(30, 32, 38, 0.95);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    overflow: hidden;
    transition-property: opacity, translate;
    transition-duration: 300ms;
    picking-mode: position;
}

.toast-exit {
    opacity: 0;
    translate: 320px 0;
}

.toast-info {
    border-color: rgba(59, 130, 246, 0.3);
}

.toast-warning {
    border-color: rgba(234, 179, 8, 0.3);
}

.toast-critical {
    border-color: rgba(239, 68, 68, 0.5);
    background-color: rgba(40, 25, 28, 0.95);
}

.toast-security {
    border-color: rgba(168, 85, 247, 0.5);
    background-color: rgba(35, 25, 45, 0.95);
}

.toast-severity-bar {
    width: 4px;
    min-height: 100%;
}

.toast-content {
    flex-grow: 1;
    padding: 8px 10px;
}

.toast-title-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.toast-title {
    font-size: 12px;
    color: rgb(220, 225, 235);
    -unity-font-style: bold;
    text-transform: uppercase;
}

.toast-dismiss {
    font-size: 14px;
    color: rgba(200, 210, 225, 0.5);
    background-color: transparent;
    border-width: 0;
    padding: 0 4px;
    min-width: 20px;
    -unity-text-align: middle-center;
}

.toast-dismiss:hover {
    color: rgb(255, 255, 255);
}

.toast-message {
    font-size: 11px;
    color: rgba(200, 210, 225, 0.7);
    padding-top: 2px;
    white-space: normal;
}

.toast-action-btn {
    font-size: 10px;
    margin-top: 4px;
    padding: 3px 10px;
    border-radius: 4px;
    background-color: rgba(59, 130, 246, 0.3);
    color: rgb(147, 197, 253);
    border-width: 0;
    align-self: flex-start;
}

.toast-action-btn:hover {
    background-color: rgba(59, 130, 246, 0.5);
    color: rgb(200, 220, 255);
}

/* ── Force Chart Anomaly Annotations ─────────────────────────── */

.anomaly-marker {
    position: absolute;
    width: 2px;
    border-left-width: 1px;
    border-left-color: rgba(255, 200, 50, 0.6);
    /* Dashed line effect via repeating gradient */
    background-image: none;
    background-color: transparent;
}

.anomaly-marker-warning {
    border-left-color: rgba(240, 210, 40, 0.7);
}

.anomaly-marker-critical {
    border-left-color: rgba(255, 60, 40, 0.8);
}

.anomaly-tooltip {
    position: absolute;
    padding: 6px 10px;
    background-color: rgba(18, 18, 28, 0.94);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 200, 50, 0.5);
    min-width: 160px;
    max-width: 220px;
}

.anomaly-tooltip-title {
    font-size: 11px;
    color: rgb(220, 225, 235);
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.anomaly-tooltip-detail {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.75);
    white-space: normal;
    margin-bottom: 2px;
}

.anomaly-tooltip-action {
    font-size: 10px;
    color: rgb(100, 200, 150);
    -unity-font-style: italic;
    white-space: normal;
}

.anomaly-badge {
    flex-direction: row;
    align-items: center;
    padding: 1px 6px;
    border-radius: 8px;
    border-width: 1px;
    min-width: 20px;
    -unity-text-align: middle-center;
}

.anomaly-badge-count {
    font-size: 10px;
    -unity-font-style: bold;
}

.anomaly-badge-warning {
    background-color: rgba(240, 210, 40, 0.2);
    border-color: rgba(240, 210, 40, 0.5);
}

.anomaly-badge-warning .anomaly-badge-count {
    color: rgb(240, 210, 40);
}

.anomaly-badge-critical {
    background-color: rgba(255, 60, 40, 0.25);
    border-color: rgba(255, 60, 40, 0.6);
}

.anomaly-badge-critical .anomaly-badge-count {
    color: rgb(255, 100, 100);
}

.severity-low {
    color: rgb(240, 210, 40);
}

.severity-medium {
    color: rgb(255, 150, 40);
}

.severity-high {
    color: rgb(255, 60, 40);
}
