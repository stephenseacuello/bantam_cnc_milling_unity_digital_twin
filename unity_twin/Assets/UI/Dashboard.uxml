<?xml version="1.0" encoding="utf-8"?>
<UXML xmlns="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="Dashboard.uss" />

    <VisualElement name="dashboard-root" class="dashboard">
        <!-- Header -->
        <VisualElement name="header" class="header-bar">
            <Label name="title" text="MIRACLE Digital Twin" class="title" />
            <DropdownField name="machine-dropdown" class="machine-dropdown" />
            <Label name="connection-status" text="Disconnected" class="connection-badge" />
        </VisualElement>

        <VisualElement name="main-content" class="main-row">
            <!-- Left Sidebar -->
            <VisualElement name="left-sidebar" class="sidebar">
                <!-- Machine Status -->
                <VisualElement class="panel">
                    <Label text="Machine" class="panel-title" />
                    <VisualElement class="data-row">
                        <Label text="Status:" class="data-label" />
                        <Label name="status-value" text="IDLE" class="data-value status-idle" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Program:" class="data-label" />
                        <Label name="program-value" text="--" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="RPM:" class="data-label" />
                        <Label name="rpm-value" text="0" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Feed:" class="data-label" />
                        <Label name="feed-value" text="0" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Load:" class="data-label" />
                        <Label name="load-value" text="0%" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Line:" class="data-label" />
                        <Label name="line-value" text="0" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Pos X:" class="data-label" />
                        <Label name="pos-x-value" text="0.0" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Pos Y:" class="data-label" />
                        <Label name="pos-y-value" text="0.0" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Pos Z:" class="data-label" />
                        <Label name="pos-z-value" text="0.0" class="data-value" />
                    </VisualElement>
                </VisualElement>

                <!-- Forces -->
                <VisualElement class="panel">
                    <Label text="Forces (N)" class="panel-title" />
                    <VisualElement class="data-row">
                        <Label text="Fx:" class="data-label force-x" />
                        <Label name="fx-value" text="0.0 N" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Fy:" class="data-label force-y" />
                        <Label name="fy-value" text="0.0 N" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Fz:" class="data-label force-z" />
                        <Label name="fz-value" text="0.0 N" class="data-value" />
                    </VisualElement>
                </VisualElement>

                <!-- Tool Wear -->
                <VisualElement class="panel">
                    <Label text="Tool Wear" class="panel-title" />
                    <ProgressBar name="wear-bar" title="Wear" low-value="0" high-value="100" class="wear-progress" />
                    <VisualElement class="data-row">
                        <Label text="VB:" class="data-label" />
                        <Label name="vb-value" text="0.020 mm" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Wear:" class="data-label" />
                        <Label name="wear-pct-value" text="0%" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Life:" class="data-label" />
                        <Label name="wear-life-value" text="45 min" class="data-value" />
                    </VisualElement>
                </VisualElement>

                <!-- Temperature -->
                <VisualElement class="panel">
                    <Label text="Temperature" class="panel-title" />
                    <VisualElement class="data-row">
                        <Label text="Tool:" class="data-label" />
                        <Label name="tool-temp-value" text="20.0 C" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Interface:" class="data-label" />
                        <Label name="interface-temp-value" text="20.0 C" class="data-value" />
                    </VisualElement>
                </VisualElement>

                <!-- Surface Roughness -->
                <VisualElement class="panel">
                    <Label text="Surface Roughness" class="panel-title" />
                    <VisualElement class="data-row">
                        <Label text="Ra:" class="data-label" />
                        <Label name="roughness-ra-value" text="-- µm" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Grade:" class="data-label" />
                        <Label name="roughness-grade-value" text="--" class="data-value" />
                    </VisualElement>
                </VisualElement>

                <!-- Raw Sensors (micro-ROS) -->
                <VisualElement class="panel">
                    <Label text="Sensors" class="panel-title" />
                    <VisualElement class="data-row">
                        <Label text="Vib:" class="data-label" />
                        <Label name="sensor-vibration-value" text="-- mm/s²" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Current:" class="data-label" />
                        <Label name="sensor-current-value" text="-- A" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Temp:" class="data-label" />
                        <Label name="sensor-temp-value" text="-- °C" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Acoustic:" class="data-label" />
                        <Label name="sensor-acoustic-value" text="--" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Coolant:" class="data-label" />
                        <Label name="sensor-coolant-value" text="-- L/min" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Link:" class="data-label" />
                        <Label name="sensor-status-value" text="No Data" class="data-value" />
                    </VisualElement>
                </VisualElement>

                <!-- OEE -->
                <VisualElement class="panel">
                    <Label text="OEE" class="panel-title" />
                    <VisualElement class="data-row">
                        <Label text="OEE:" class="data-label" />
                        <Label name="oee-value" text="0%" class="data-value oee-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Avail:" class="data-label" />
                        <Label name="avail-value" text="0%" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Perf:" class="data-label" />
                        <Label name="perf-value" text="0%" class="data-value" />
                    </VisualElement>
                    <VisualElement class="data-row">
                        <Label text="Qual:" class="data-label" />
                        <Label name="qual-value" text="0%" class="data-value" />
                    </VisualElement>
                </VisualElement>

                <!-- Live Charts -->
                <VisualElement class="panel">
                    <Label text="Forces (Fx/Fy/Fz)" class="panel-title chart-title" />
                    <VisualElement name="force-chart" class="chart-container" />
                </VisualElement>

                <VisualElement class="panel">
                    <Label text="Temperature (°C)" class="panel-title chart-title" />
                    <VisualElement name="thermal-chart" class="chart-container" />
                </VisualElement>

                <VisualElement class="panel">
                    <Label text="Tool Wear VB (mm)" class="panel-title chart-title" />
                    <VisualElement name="tool-wear-chart" class="chart-container" />
                </VisualElement>

                <VisualElement class="panel">
                    <Label text="Power (W)" class="panel-title chart-title" />
                    <VisualElement name="power-chart" class="chart-container" />
                </VisualElement>
            </VisualElement>

            <!-- 3D Viewport (transparent pass-through) -->
            <VisualElement name="viewport" class="viewport" />

            <!-- Right Sidebar: G-Code Editor -->
            <VisualElement name="right-sidebar" class="sidebar gcode-sidebar">
                <VisualElement class="panel">
                    <Label text="G-Code Program" class="panel-title" />
                    <VisualElement class="gcode-toolbar">
                        <Button name="load-file-button" text="Load File" class="control-btn" />
                        <Button name="run-button" text="Run" class="control-btn play" />
                        <Button name="stop-button" text="Stop" class="control-btn" />
                    </VisualElement>
                    <ProgressBar name="gcode-progress-bar" title="Progress" low-value="0" high-value="100" class="gcode-progress-bar" />
                    <VisualElement class="gcode-status-row">
                        <Label name="line-count" text="0 lines" class="data-value" />
                        <Label name="gcode-progress" text="" class="data-value" />
                    </VisualElement>
                    <VisualElement class="gcode-info-row">
                        <Label text="G = Run pocket_50x50" class="data-label shortcut-hint" />
                    </VisualElement>
                    <TextField name="gcode-editor" multiline="true" class="gcode-text-field" />
                </VisualElement>
            </VisualElement>

            <!-- Fleet Overview Panel (toggleable overlay) -->
            <VisualElement name="fleet-overview-panel" class="fleet-panel">
                <VisualElement class="fleet-panel-header">
                    <Label text="Fleet Overview" class="panel-title" />
                    <Button name="fleet-close-btn" text="X" class="control-btn" />
                </VisualElement>
                <VisualElement name="fleet-grid" class="fleet-grid" />
            </VisualElement>

            <!-- Decision Support Panel (slide-out) -->
            <VisualElement name="decision-support-panel" class="decision-panel">
                <VisualElement class="decision-panel-header">
                    <Label text="Decision Support" class="panel-title" />
                    <Button name="decision-close-btn" text="X" class="control-btn" />
                </VisualElement>
                <Label name="decision-situation" text="" class="decision-situation" />
                <VisualElement class="decision-section">
                    <Label text="Root Cause" class="decision-section-title" />
                    <Label name="decision-root-cause" text="--" class="decision-root-cause" />
                </VisualElement>
                <VisualElement class="decision-section">
                    <Label text="Recommended Actions" class="decision-section-title" />
                    <VisualElement name="decision-actions-list" class="decision-actions-list" />
                </VisualElement>
                <VisualElement class="decision-section">
                    <Label text="What-If Analysis" class="decision-section-title" />
                    <Slider name="whatif-slider" label="Feed Override %" low-value="10" high-value="100" value="100" class="whatif-slider" />
                    <Label name="whatif-result" text="" class="whatif-result" />
                </VisualElement>
            </VisualElement>
        </VisualElement>

        <!-- Bottom Control Bar -->
        <VisualElement name="control-bar" class="control-bar">
            <Button name="play-btn" text="Play" class="control-btn play" />
            <Button name="pause-btn" text="Pause" class="control-btn" />
            <Button name="stop-btn" text="Stop" class="control-btn" />
            <Slider name="speed-slider" label="Speed" low-value="0.1" high-value="100" value="1" class="speed-slider" />
            <Label name="speed-label" text="1.0x" class="speed-text" />
            <DropdownField name="mode-dropdown" label="Mode" class="mode-dropdown" />
            <Button name="load-gcode-btn" text="Load G-code" class="control-btn" />
            <Button name="record-btn" text="REC" class="control-btn record" />
            <Button name="replay-btn" text="Replay" class="control-btn" />
            <Slider name="replay-timeline" low-value="0" high-value="1" value="0" class="replay-slider" />
            <Label name="replay-time-label" text="" class="replay-time" />
            <Label name="sim-time-value" text="00:00:00.0" class="sim-time" />
            <VisualElement class="spacer" />
            <Label name="ned2-status" text="Ned2: IDLE" class="robot-status" />
            <Label name="xarm6-status" text="xArm6: IDLE" class="robot-status" />
            <Button name="estop-btn" text="E-STOP" class="estop-btn" />
        </VisualElement>
    </VisualElement>
</UXML>
